{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "fitcore": {
      "root": ".",
      "entrypoint": "gym_management.asgi:application",
      "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then python manage.py migrate --noinput; fi && python manage.py collectstatic --noinput",
      "functions": {
        "gym_management/asgi.py": {
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "fitcore" } }
  ]
}
