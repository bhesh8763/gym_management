<?xml version="1.0" encoding="UTF-16"?>
<!--
  GymDailyReminders.xml
  Windows Task Scheduler task definition.

  Import with (elevated PowerShell):
    schtasks /create /xml "C:\path\to\gym\scripts\GymDailyReminders.xml" /tn "GymDailyReminders"

  IMPORTANT: Update the <Command> and <WorkingDirectory> paths below
  to match your actual install location before importing.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Runs the Gym Management System daily notification reminders (membership expiry, payment due, inactivity, workout reminders).</Description>
    <Author>Gym Management System</Author>
  </RegistrationInfo>

  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T08:00:00</StartBoundary>
      <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>

  <Principals>
    <Principal id="Author">
      <!-- Change to a specific service account if available -->
      <LogonType>S4U</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <Enabled>true</Enabled>
    <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>

  <Actions Context="Author">
    <Exec>
      <!-- UPDATE THIS PATH -->
      <Command>C:\Users\bsaru\Desktop\gym\scripts\run_reminders.bat</Command>
      <WorkingDirectory>C:\Users\bsaru\Desktop\gym</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
