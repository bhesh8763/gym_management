# FitCore environment template — copy to `.env` and fill in.
# Read by gym_management/settings.py via python-decouple; `.env` is gitignored.

# ─── Core ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Comma-separated; production needs the real host. Render sets
# RENDER_EXTERNAL_HOSTNAME automatically, Vercel sets VERCEL_URL /
# VERCEL=1 — both are allowlisted by settings without extra config.
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Database (production) ────────────────────────────────────────────────────
DB_NAME=gym_db
DB_USER=gym_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# TLS mode for managed Postgres (Neon requires SSL). Empty or unset = prefer,
# which negotiates SSL when offered — works for both localhost and Neon.
DB_SSLMODE=prefer

# ─── Media storage (production / Vercel) ──────────────────────────────────────
# Vercel's filesystem is read-only, so uploads need Cloudinary. Create a free
# account at cloudinary.com and copy the credential string from the dashboard
# ("API Keys" -> URL form). Unset locally => files land in media/ as before.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ─── Frontend URL ─────────────────────────────────────────────────────────────
# Used for password-reset links and Khalti return_url.
# Production: FRONTEND_URL=https://fitcore-gym-manage.vercel.app
FRONTEND_URL=http://127.0.0.1:5500

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave EMAIL_HOST_USER / EMAIL_HOST_PASSWORD EMPTY to print emails to the
# console (the development default). Set BOTH and the backend switches to
# SMTP automatically — you do NOT need to set EMAIL_BACKEND.
#
# Gmail example (use an App Password, myaccount.google.com → App passwords):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
#   DEFAULT_FROM_EMAIL=FitCore <you@gmail.com>   # must be that same address
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FitCore <noreply@fitcore.local>
# EMAIL_TIMEOUT=15
# EMAIL_BACKEND=            # optional explicit override; wins over the auto choice

# ─── Web Push (PWA notifications) ─────────────────────────────────────────────
# generate with: python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Payments (sandbox defaults work locally) ─────────────────────────────────
# Khalti sandbox: test-admin.khalti.com (login OTP is always 987654).
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_WEBHOOK_URL=
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_BASE_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_CHECK_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# ─── Social login (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Production flags (set these in Vercel's environment for the live site) ───
# TENANCY_REQUIRE_MEMBERSHIP=True   # reject API calls without an active gym membership
# REQUIRE_OWNER_SUBSCRIPTION=True    # enforce the paid owner-plan gate on management APIs
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app   # *.vercel.app is auto-added when VERCEL=1
# CORS_ALLOWED_ORIGINS=              # extra comma-separated browser origins (split frontend)
# TRUST_X_FORWARDED_PROTO=True      # honor X-Forwarded-Proto (Vercel sets it) for is_secure()/cookies
# SESSION_COOKIE_SECURE=True        # session + CSRF cookies over HTTPS only
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=False         # Vercel's edge already 308-redirects http->https with HSTS;
#                                   # Django-level redirect is redundant (kept off to avoid loops)
# DATA_UPLOAD_MAX_MEMORY_SIZE=4000000   # keep Django's 5 MB defaults under Vercel's ~4.5 MB body cap
# FILE_UPLOAD_MAX_MEMORY_SIZE=4000000
