# FitCore environment template — copy to `.env` and fill in.
# Read by gym_management/settings.py via python-decouple; `.env` is gitignored.

# ─── Core ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Comma-separated; production needs the real host (Render sets
# RENDER_EXTERNAL_HOSTNAME automatically, which is also allowlisted).
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Database (production / Render) ───────────────────────────────────────────
DB_NAME=gym_db
DB_USER=gym_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ─── Frontend URL ─────────────────────────────────────────────────────────────
# Used for password-reset links and Khalti return_url.
FRONTEND_URL=http://127.0.0.1:5500

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave EMAIL_HOST_USER / EMAIL_HOST_PASSWORD EMPTY to print emails to the
# console (the development default). Set BOTH and the backend switches to
# SMTP automatically — you do NOT need to set EMAIL_BACKEND.
#
# Gmail example (use an App Password, myaccount.google.com → App passwords):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
#   DEFAULT_FROM_EMAIL=FitCore <you@gmail.com>   # must be that same address
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FitCore <noreply@fitcore.local>
# EMAIL_TIMEOUT=15
# EMAIL_BACKEND=            # optional explicit override; wins over the auto choice

# ─── Web Push (PWA notifications) ─────────────────────────────────────────────
# generate with: python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Payments (sandbox defaults work locally) ─────────────────────────────────
# Khalti sandbox: test-admin.khalti.com (login OTP is always 987654).
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_WEBHOOK_URL=
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_BASE_URL=https://rc.esewa.com.np/api/payment/epay/
ESEWA_STATUS_CHECK_URL=https://rc.esewa.com.np/api/transaction/status/

# ─── Social login (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
